# /etc/az-guard.conf (chmod 600, исполняется как shell). Пример: NL2, 10.11.2026.
HAS_IPV6=1                                   # на ноде есть рабочий глобальный IPv6
EGRESS_IFACES="proton warp-antizapret"       # порядок = приоритет (metric 100, 200, ...)
INGRESS_IPS="45.133.119.44"                  # входные IP ноды (egress обязан отличаться)
PANEL_PORT=9100                              # порт node-agent (ограничен правилами az-panel-only)
# LAYERS: имя:iface:v4cidr[,..]:v6cidr[,..] через пробел. iface = клиентский интерфейс слоя (AWG 1.5/2/3, WG, OpenVPN tun).
LAYERS="AZ-WG:antizapret:10.29.8.0/24: AZ-AWG:antizapret2:10.29.9.0/24: VPN-WG:vpn:10.28.8.0/24: VPN-AWG:vpn2:10.28.9.0/24: AWG15:awg1:10.9.0.0/24,10.9.1.0/24: OVPN-AZ-U:antizapret-udp:10.29.0.0/22: OVPN-AZ-T:antizapret-tcp:10.29.4.0/22: OVPN-V-U:vpn-udp:10.28.0.0/22: OVPN-V-T:vpn-tcp:10.28.4.0/22:"
# Базовые policy-правила AntiZapret/Proton, которые монитор возвращает после networkctl reconfigure ("семейство|аргументы ip rule add").
BASE_RULES="-4|oif proton lookup 51820 priority 1000
-4|from 10.29.0.0/16 to 10.29.0.0/16 lookup main priority 5000
-4|from 10.9.0.0/24 to 10.9.0.0/24 lookup main priority 5000
-4|from 10.9.1.0/24 to 10.9.1.0/24 lookup main priority 5000
-4|from 10.29.0.0/16 lookup 13335 priority 10000
-4|from 10.9.0.0/24 lookup 13335 priority 10000
-6|oif proton lookup 51820 priority 1000
-6|oif warp-antizapret lookup 13335 priority 1001"
