#!/bin/sh
# rtctl - запрет (nfqws: стратегии 1-3, nfqws2: стратегии 4-5, автоподбор) и AWG-туннели домашнего Кинетика.
IPT=/opt/sbin/iptables
Z=/opt/zapret
# узлы AWG определяются по интерфейсам Кинетика: описание вида "3.0_<ИМЯ>_AZ_AWG_..." -> кнопка <ИМЯ> (номер интерфейса WireguardN)
IFS_MAP=$(ndmc -c "show running-config" 2>/dev/null | awk '/^interface Wireguard[0-9]+$/{n=$2; sub("Wireguard","",n); next} n && /^    description /{d=$2; if (d ~ /^[0-9]\.[0-9]_[A-Za-z0-9]+_AZ_AWG/) {split(d,a,"_"); nm=a[2]; v=a[1]; if (v!="3.0") {gsub(/\./,"",v); nm=nm "v" v}; print n":"nm} n=""} /^!/{n=""}' | tr '\n' ' ')
running() { pidof nfqws >/dev/null || pidof nfqws2 >/dev/null; }
yt_ip() { nslookup www.youtube.com 192.168.1.1 2>/dev/null | grep -E '^Address' | awk '{print $NF}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^192\.168\.' | head -1; }
awg_state() {
  for p in $IFS_MAP; do n=${p%%:*}; name=${p##*:}
    ip -br link show nwg$n 2>/dev/null | grep -qE 'UP|UNKNOWN' && { echo "$n:$name"; return; }
  done; echo "none"
}
hook() { type=iptables table=mangle sh /opt/etc/ndm/netfilter.d/91-nfqws.sh >/dev/null 2>&1; }
stop_all() { /opt/etc/init.d/S98nfqws stop >/dev/null 2>&1; kill $(pidof nfqws) $(pidof nfqws2) 2>/dev/null; sleep 1; }
start_cur() { /opt/etc/init.d/S98nfqws start >/dev/null 2>&1; sleep 2; hook; }
restart_nfqws() { stop_all; start_cur; }
score() {
  ok=0; sum=0
  for i in 1 2 3 4 5; do
    r=$(curl -s -o /dev/null -m5 -w '%{http_code} %{time_total}' https://redirector.googlevideo.com/ 2>/dev/null)
    c=${r% *}; t=${r#* }
    if [ "$c" != "000" ] && [ -n "$c" ]; then ok=$((ok+1)); sum=$(awk -v s=$sum -v t=$t 'BEGIN{printf "%d", s+t*1000}'); fi
  done
  [ $ok -gt 0 ] && avg=$((sum/ok)) || avg=0
  echo "$ok:$avg"
}
status() {
  running && ZP=on || ZP=off
  PK=$($IPT -t mangle -L NFQWS -v -n 2>/dev/null | awk '/dpt:443/ && /tcp/ {print $1}' | head -1)
  YIP=""; VIA=tunnel; CODE=0; TM=0
  if true; then

    R=$(curl -s -o /dev/null -m8 -x http://127.0.0.1:7890 -w '%{http_code} %{time_total}' https://www.youtube.com/ 2>/dev/null) && { CODE=${R% *}; TM=${R#* }; }
  fi
  A=$(awg_state); AN=${A%%:*}; ANAME=${A##*:}; PING=fail
  if [ "$A" != none ]; then PING=$(ping -c2 -W2 10.9.0.1 2>/dev/null | awk -F'/' '/round-trip/ {print $5}'); [ -z "$PING" ] && PING=fail; fi
  echo "zapret=$ZP"; echo "zapret_pkts=$PK"; echo "zapret_strategy=$(cat $Z/strategy 2>/dev/null || echo 1)"; echo "zapret_scores=$(cat $Z/scores 2>/dev/null)"
  echo "yt_ip=$YIP"; echo "yt_via=$VIA"; echo "yt_code=$CODE"; echo "yt_time=$TM"
  echo "awg=$ANAME"; echo "awg_if=$AN"; echo "awg_ping=$PING"; echo "awg_list=$(echo $IFS_MAP | tr ' ' '\n' | cut -d: -f2 | tr '\n' ',' | sed 's/,$//')"
  echo "mihomo=$(pidof mihomo >/dev/null && echo on || echo off)"
  echo "time=$(date +%s)"
}
case "$1" in
  status) status ;;
  zapret|strategy)
    echo "zapret удалён"; exit 0 ;;
  zapret_old)
    case "$2" in
      on)  rm -f /opt/etc/zapret.off; start_cur; echo "запрет включён" ;;
      off) touch /opt/etc/zapret.off; stop_all; echo "запрет выключен" ;;
      strategy)
        case "$3" in 1|2|3|4|5) ;; *) echo "usage: zapret strategy 1|2|3|4|5"; exit 2 ;; esac
        echo "$3" > $Z/strategy; restart_nfqws; echo "стратегия $3: $(score)" ;;
      auto)
        best=""; bok=-1; bavg=999999; out=""
        for n in 1 2 3 4 5; do
          echo "$n" > $Z/strategy; restart_nfqws; s=$(score); ok=${s%%:*}; avg=${s##*:}
          out="$out $n:$s"
          if [ "$ok" -gt "$bok" ] || { [ "$ok" -eq "$bok" ] && [ "$avg" -lt "$bavg" ] && [ "$ok" -gt 0 ]; }; then best=$n; bok=$ok; bavg=$avg; fi
        done
        [ -z "$best" ] && best=1
        echo "$best" > $Z/strategy; restart_nfqws
        echo "$out" | sed 's/^ //' > $Z/scores
        echo "автоподбор: лучшая стратегия $best (результаты $(cat $Z/scores))" ;;
      *) echo "usage: zapret on|off|strategy N|auto"; exit 2 ;;
    esac ;;
  awg)
    [ "$2" = none ] || echo " $IFS_MAP" | grep -q ":$2 " || { echo "неизвестный узел: $2 (есть: $IFS_MAP)"; exit 2; }
    for p in $IFS_MAP; do n=${p%%:*}; name=${p##*:}; [ "$name" != "$2" ] && ndmc -c "interface Wireguard$n down" >/dev/null 2>&1; done
    for p in $IFS_MAP; do n=${p%%:*}; name=${p##*:}; [ "$name" = "$2" ] && ndmc -c "interface Wireguard$n up" >/dev/null 2>&1; done
    ndmc -c "system configuration save" >/dev/null 2>&1
    sleep 8; echo "AWG: $(awg_state)" ;;
  *) echo "usage: rtctl status | zapret on|off|strategy N|auto | awg none|DE1|LV1|NL2|DE2"; exit 2 ;;
esac
