[Unit]
Description=NAT66 для ULA-клиентов AntiZapret
After=network-online.target nftables.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nft-az-nat66.nft
ExecStop=/usr/sbin/nft delete table ip6 az_nat66
[Install]
WantedBy=multi-user.target
