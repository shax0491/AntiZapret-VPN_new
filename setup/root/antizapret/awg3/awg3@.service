[Unit]
Description=AmneziaWG 3.0 interface %i
# после antizapret.service: awg3-rules.sh использует цепочку ANTIZAPRET-WARP и интерфейсы warp-*, которые создаёт up.sh
After=network-online.target antizapret.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/awg3-up.sh %i
ExecStop=/usr/local/sbin/awg3-up.sh down %i

[Install]
WantedBy=multi-user.target
